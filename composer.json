{
    "name": "oceanmoon/color",
    "description": "Immutable, memory-efficient PHP Color class with RGB/HSL support, CSS color names, and WCAG accessibility features.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "color",
        "colour",
        "rgb",
        "hsl",
        "hex",
        "css",
        "wcag",
        "accessibility",
        "immutable"
    ],
    "authors": [
        {
            "name": "Shaun Moss",
            "email": "shaun@oceanmoon.software"
        }
    ],
    "homepage": "https://github.com/mossy2100/PHP-Color",
    "support": {
        "issues": "https://github.com/mossy2100/PHP-Color/issues",
        "source": "https://github.com/mossy2100/PHP-Color"
    },
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "oceanmoon/core": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "oceanmoon/coding-standard": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "OceanMoon\\Color\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OceanMoon\\Color\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "vendor/bin/phpcbf -vp",
        "check": "vendor/bin/phpcs -s",
        "report": "vendor/bin/phpcs -q --report=summary",
        "analyze": "scripts/analyze",
        "test": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html build/coverage --coverage-clover build/logs/clover.xml --do-not-cache-result",
        "coverage": "php scripts/coverage-check.php",
        "quality": [
            "@fix",
            "@check",
            "@analyze",
            "@test",
            "@coverage"
        ]
    }
}
